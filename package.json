{
  "name": "pi-graphnav",
  "version": "0.2.2",
  "description": "CodeGraph-first code navigation for pi: persistent index, auto init/sync, and a gate that steers structural searches to codegraph_* tools.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codegraph",
    "code-intelligence",
    "mcp"
  ],
  "license": "MIT",
  "author": "Sorin Albu-Irimies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorinirimies/pi-graphnav.git"
  },
  "homepage": "https://github.com/sorinirimies/pi-graphnav#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/graphnav.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "fuzz": "nu scripts/ci/fuzz.nu",
    "check": "nu scripts/ci/quality_gate.nu"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "overrides": {
    "undici": "8.12.3",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "@earendil-works/pi-ai": "^1.4.0"
  },
  "dependencies": {
    "arrow-resilience-kit": "^0.10.2"
  }
}
