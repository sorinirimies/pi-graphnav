{
  "name": "pi-codegraph",
  "version": "0.1.0",
  "description": "CodeGraph-first code navigation for pi: persistent index, auto init/sync, and a gate that steers structural searches to codegraph_* tools.",
  "keywords": ["pi-package", "pi-extension"],
  "license": "MIT",
  "author": "Sorin Albu-Irimies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorinirimies/pi-codegraph.git"
  },
  "homepage": "https://github.com/sorinirimies/pi-codegraph#readme",
  "files": ["extensions", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions/codegraph.ts"]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "fuzz": "nu scripts/ci/fuzz.nu",
    "check": "nu scripts/ci/quality_gate.nu"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "overrides": {
    "undici": "8.12.3",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
